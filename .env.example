# Copy to .env and set values for production.
# Never commit .env. The default compose password is fine for localhost ONLY.

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Comma-separated API keys. Empty + AUTH_DISABLED=false → all non-public endpoints return 401.
API_KEYS=

# Set AUTH_DISABLED=true to run without keys (local dev only).
AUTH_DISABLED=false

# Set to true only when you're behind a trusted reverse proxy (nginx, Traefik, ALB).
# Required for X-Forwarded-For to be honoured for rate-limit client IP detection.
TRUSTED_PROXY=false

# Model + translation (see README). Default is mock.
# For real transcription run the model gateway (model-gateway/README.md) and set:
#   MODEL_PROVIDER=http
#   MODEL_HTTP_BASE_URL=http://localhost:4011
MODEL_PROVIDER=mock
TRANSLATION_PROVIDER=mock

# Allow MODEL_HTTP_BASE_URL to point at a private-network host (e.g. the
# docker-compose model-gateway service). Never needed for public HTTPS APIs.
MODEL_HTTP_ALLOW_PRIVATE=false

# Do NOT enable in production. Silent mock fallback hides real outages.
MODEL_FALLBACK_ON_ERROR=false

# --- Model gateway (model-gateway/server.js) ---
# WHISPER_BACKEND: whispercpp | openai | mock
WHISPER_BACKEND=mock
# whispercpp: path to a ggml model, e.g. ggml-base.en.bin
WHISPER_CPP_MODEL=
# openai: pay-per-minute API transcription instead of local inference
OPENAI_API_KEY=
# Optional bearer token the gateway requires (recommended outside docker-internal networks)
GATEWAY_API_KEY=
